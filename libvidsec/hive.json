{
  "group": "org.parabellum.vidsec",
  "name": "libvidsec",
  "version": "2.0.2",
  "repositories": [
    {
      "name": "local",
      "type": "local",
      "path": "~/.hive/packages"
    }
  ],
  "dependencies": {
    "org.parabellum.drivers:memory": {
      "version": "2.0.4",
      "repo": "local"
    },
    "org.parabellum.drivers:file_store": {
      "version": "2.0.4",
      "repo": "local"
    },
    "org.parabellum.drivers:sqlite": {
      "version": "2.0.4",
      "repo": "local"
    }
  },
  "abi": {
    "required_symbols": [
      "parabellum_module_manifest"
    ]
  },
  "packaging": {
    "default_format": "so"
  }
}
