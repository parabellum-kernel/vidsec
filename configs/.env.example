# =============================================================================
# VidSec v2 — Portable Environment Configuration
# =============================================================================
# Loaded automatically from the same directory as pipeline.yaml.
# ${PARABELLUM_EXE_DIR} resolves to the physical directory of the binary
# (exported automatically at startup), so DB/logs/artifacts stay next to the
# binaries regardless of the working directory. ~/ paths expand to $HOME.

# --- Config Base Path --------------------------------------------------------
# Base directory where pipeline.yaml, schemas.yaml, and capabilities.yaml live
PARABELLUM_CONFIG_DIR=${PARABELLUM_EXE_DIR}/configs

# --- Storage & Pipeline Outputs ----------------------------------------------
# SQLite database for audit logs, triage results, and IR metadata
VIDSEC_DB_PATH=${PARABELLUM_EXE_DIR}/vidsec_state.db
# Output directory for CDR-sanitized media artifacts
VIDSEC_ARTIFACTS_DIR=${PARABELLUM_EXE_DIR}/artifacts
# Output directory for quarantined/hostile files
VIDSEC_QUARANTINE_DIR=${PARABELLUM_EXE_DIR}/quarantine

# --- Telemetry & Logs --------------------------------------------------------
# OpenTelemetry span/event log file
PARABELLUM_OTEL_FILE=${PARABELLUM_EXE_DIR}/logs/otel_export.log
# Print OpenTelemetry events to stderr/console (true | false)
PARABELLUM_OTEL_CONSOLE=false
OTEL_LOG_CONSOLE=false
# Service name reported in OpenTelemetry spans
OTEL_SERVICE_NAME=vidsec
# Structured JSONL execution trace file
PARABELLUM_TRACE_OUT=${PARABELLUM_EXE_DIR}/logs/trace.jsonl

# --- Optional Overrides (uncomment to customize) -----------------------------
# Override directory containing pipeline.yaml, schemas.yaml, capabilities.yaml
# VIDSEC_CONFIG_DIR=
# Override schemas.yaml path (auto-resolved next to pipeline.yaml by default)
# VIDSEC_SCHEMA_PATH=
# Base data directory used when DB/ARTIFACTS/QUARANTINE paths are not set
# VIDSEC_DATA_DIR=
# Initial directory for the TUI file browser (defaults to PWD / HOME)
# VIDSEC_CALLER_PWD=
