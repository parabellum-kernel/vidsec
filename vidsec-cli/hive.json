{
  "group": "org.parabellum.vidsec",
  "name": "vidsec",
  "version": "2.0.2",
  "repositories": [
    {
      "name": "local",
      "type": "local",
      "path": "~/.hive/packages"
    }
  ],
  "dependencies": {
    "org.parabellum.vidsec:libvidsec": {
      "version": "2.0.2",
      "repo": "local"
    },
    "org.parabellum.extensions:opentelemetry": {
      "version": "2.0.4",
      "repo": "local"
    },
    "org.parabellum.extensions:trace_jsonl": {
      "version": "2.0.4",
      "repo": "local"
    },
    "org.parabellum.extensions:yaml_config": {
      "version": "2.0.4",
      "repo": "local"
    },
    "org.parabellum.extensions:inbound_cli": {
      "version": "2.0.4",
      "repo": "local"
    }
  },
  "packaging": {
    "default_format": "bin",
    "entrypoint": "libvidsec_cli.a",
    "link_libs": ["c", "sqlite3"],
    "packagers": {
      "deb-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.deb"],
        "command": ["fpm", "-s", "dir", "-t", "deb", "-n", "vidsec", "-v", "2.0.2", "-p", "{input}.deb", "{input}"]
      },
      "rpm-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.rpm"],
        "command": ["fpm", "-s", "dir", "-t", "rpm", "-n", "vidsec", "-v", "2.0.2", "-p", "{input}.rpm", "{input}"]
      },
      "appimage-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.AppImage"],
        "command": ["appimagetool", "{input}", "{input}.AppImage"]
      },
      "flatpak-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.flatpak"],
        "command": ["flatpak", "build-bundle", "repo", "{input}.flatpak", "org.parabellum.VidSec"]
      },
      "dmg-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.dmg"],
        "command": ["hdiutil", "create", "-volname", "VidSec", "-srcfolder", "{input}", "-ov", "-format", "UDZO", "{input}.dmg"]
      },
      "msi-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.msi"],
        "command": ["wixl", "-o", "{input}.msi", "installer.wxs"]
      },
      "corp-sign": {
        "mode": "sidecar",
        "outputs": ["{input}.sig"],
        "command": ["cosign", "sign-blob", "--output-signature", "{input}.sig", "{input}"]
      },
      "tar-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.tar.gz"],
        "command": ["tar", "-czf", "{input}.tar.gz", "--exclude=*.tar.gz", "--exclude=*.zip", "-C", "zig-out/dist", ".", "-C", "../../..", "configs", "README.md"]
      },
      "zip-pack": {
        "mode": "sidecar",
        "outputs": ["{input}.zip"],
        "command": ["tar", "-a", "-cf", "{input}.zip", "--exclude=*.tar.gz", "--exclude=*.zip", "-C", "zig-out/dist", ".", "-C", "../../..", "configs", "README.md"]
      }
    },
    "profiles": {
      "linux": {
        "format": "bin",
        "target": "x86_64-linux-gnu",
        "strip": true
      },
      "linux-portable": {
        "format": "bin",
        "target": "x86_64-linux-gnu",
        "strip": true,
        "packagers": ["tar-pack"]
      },
      "macos": {
        "format": "bin",
        "target": "aarch64-macos",
        "strip": true
      },
      "macos-portable": {
        "format": "bin",
        "target": "aarch64-macos",
        "strip": true,
        "packagers": ["tar-pack"]
      },
      "windows": {
        "format": "bin",
        "target": "x86_64-windows-gnu",
        "strip": true
      },
      "windows-portable": {
        "format": "bin",
        "target": "x86_64-windows-gnu",
        "strip": true,
        "packagers": ["zip-pack"]
      },
      "deb": {
        "format": "bin",
        "target": "x86_64-linux-gnu",
        "strip": true,
        "packagers": ["deb-pack"]
      },
      "rpm": {
        "format": "bin",
        "target": "x86_64-linux-gnu",
        "strip": true,
        "packagers": ["rpm-pack"]
      },
      "appimage": {
        "format": "bin",
        "target": "x86_64-linux-gnu",
        "strip": true,
        "packagers": ["appimage-pack"]
      },
      "flatpak": {
        "format": "bin",
        "target": "x86_64-linux-gnu",
        "strip": true,
        "packagers": ["flatpak-pack"]
      },
      "dmg": {
        "format": "bin",
        "target": "aarch64-macos",
        "strip": true,
        "packagers": ["dmg-pack"]
      },
      "msi": {
        "format": "bin",
        "target": "x86_64-windows-gnu",
        "strip": true,
        "packagers": ["msi-pack"]
      }
    }
  }
}
